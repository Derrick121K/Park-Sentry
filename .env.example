# DATABASE
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=parksentry;Username=parksentry;Password=CHANGE_ME

# JWT / IDENTITY
Jwt__Key=CHANGE_ME_TO_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS
Jwt__Issuer=ParkSentry
Jwt__Audience=ParkSentry.Api
Jwt__ExpiryMinutes=60

# INTEGRATIONS (Demo | Production)
Integrations__Mode=Demo
Integrations__AllowDemoProviders=false

# PAYMENTS (Mock | Manual | future gateway)
Payments__Provider=Mock
Payments__WebhookSecret=

# SCANNING / OCR (Demo | Browser | Manual | future OCR)
Scanning__Provider=Browser
Scanning__RetainImages=false
Scanning__OcrApiKey=
Scanning__OcrEndpoint=

# CORS (comma-separated origins via array env: Cors__AllowedOrigins__0=https://app.example.com)
# Cors__AllowedOrigins__0=

# APPLICATION
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000
Application__PublicUrl=https://localhost:5001

# LOGGING
Serilog__MinimumLevel__Default=Information

# STORAGE / EMAIL / SMS (optional future providers)
Email__Provider=
Email__ApiKey=
Sms__Provider=
Sms__ApiKey=
Storage__Provider=
Storage__ConnectionString=

# SIGNALR (usually defaults; reverse proxy must support WebSockets)
# SignalR__EnableDetailedErrors=false
