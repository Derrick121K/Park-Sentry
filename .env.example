# PostgreSQL connection (override appsettings.json)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=parksentry;Username=parksentry;Password=CHANGE_ME

# JWT settings (API)
Jwt__Key=CHANGE_ME_TO_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS
Jwt__Issuer=ParkSentry
Jwt__Audience=ParkSentry.Api
Jwt__ExpiryMinutes=60

# Application
ASPNETCORE_ENVIRONMENT=Development
