{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "ParkSentry",
    "Audience": "ParkSentry.Api",
    "ExpiryMinutes": "60"
  },
  "Integrations": {
    "Mode": "Demo",
    "AllowDemoProviders": false
  },
  "Payments": {
    "Provider": "Mock",
    "WebhookSecret": ""
  },
  "Scanning": {
    "Provider": "Demo",
    "RetainImages": false,
    "OcrApiKey": "",
    "OcrEndpoint": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Seed": {
    "EnableDevelopmentSeed": true
  },
  "Swagger": {
    "Enabled": false
  }
}
