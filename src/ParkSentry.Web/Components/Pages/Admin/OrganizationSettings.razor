@page "/admin/organization"
@attribute [Authorize(Roles = "SUPER_ADMIN,ORGANIZATION_ADMIN")]
@inject OrganizationService OrganizationService
@inject ITenantContext TenantContext
@rendermode InteractiveServer

<PageTitle>Organization - ParkSentry</PageTitle>

<h1>Organization Settings</h1>

@if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-danger">@Error</div> }
@if (!string.IsNullOrEmpty(Message)) { <div class="alert alert-success">@Message</div> }

@if (Org is null)
{
    <p>Loading...</p>
}
else
{
    <div class="card">
        <h3>@Org.Name</h3>
        <div class="form-grid">
            <label>Display name <input class="form-control" @bind="DisplayName" /></label>
            <label>Contact email <input class="form-control" @bind="ContactEmail" /></label>
            <label>Contact phone <input class="form-control" @bind="ContactPhone" /></label>
            <label>Address <input class="form-control" @bind="Address" /></label>
            <label>Safety fee amount <input class="form-control" type="number" step="0.01" @bind="SafetyFeeAmount" /></label>
            <label><input type="checkbox" @bind="SafetyFeeEnabled" /> Safety fee enabled</label>
            <label><input type="checkbox" @bind="IsActive" /> Active</label>
        </div>
        <button class="btn btn-primary" @onclick="SaveOrgAsync" disabled="@Busy">Save settings</button>
    </div>

    <div class="card">
        <h3>Branding</h3>
        <div class="form-grid">
            <label>Logo URL <input class="form-control" @bind="LogoUrl" /></label>
            <label>Primary color <input class="form-control" @bind="PrimaryColor" /></label>
            <label>Secondary color <input class="form-control" @bind="SecondaryColor" /></label>
            <label>Accent color <input class="form-control" @bind="AccentColor" /></label>
        </div>
        <button class="btn btn-primary" @onclick="SaveBrandingAsync" disabled="@Busy">Save branding</button>
    </div>
}

@code {
    private OrganizationDetailDto? Org;
    private string DisplayName = "", ContactEmail = "", ContactPhone = "", Address = "";
    private string LogoUrl = "", PrimaryColor = "#1B2A4A", SecondaryColor = "#00A896", AccentColor = "";
    private decimal SafetyFeeAmount;
    private bool SafetyFeeEnabled, IsActive = true, Busy;
    private string? Error, Message;

    protected override async Task OnInitializedAsync()
    {
        Org = await OrganizationService.GetCurrentAsync();
        if (Org is null) return;
        DisplayName = Org.DisplayName;
        ContactEmail = Org.ContactEmail ?? "";
        ContactPhone = Org.ContactPhone ?? "";
        Address = Org.Address ?? "";
        SafetyFeeEnabled = Org.SafetyFeeEnabled;
        SafetyFeeAmount = Org.SafetyFeeAmount;
        IsActive = Org.IsActive;
        LogoUrl = Org.LogoUrl ?? "";
        PrimaryColor = Org.PrimaryColor;
        SecondaryColor = Org.SecondaryColor;
        AccentColor = Org.AccentColor ?? "";
    }

    private async Task SaveOrgAsync()
    {
        if (Org is null) return;
        Busy = true; Error = Message = "";
        try
        {
            Org = await OrganizationService.UpdateAsync(Org.Id, new UpdateOrganizationRequest(
                DisplayName, ContactEmail, ContactPhone, Address, IsActive, SafetyFeeEnabled, SafetyFeeAmount));
            Message = "Organization updated.";
        }
        catch (Exception ex) { Error = ex.Message; }
        finally { Busy = false; }
    }

    private async Task SaveBrandingAsync()
    {
        if (Org is null) return;
        Busy = true; Error = Message = "";
        try
        {
            Org = await OrganizationService.UpdateBrandingAsync(Org.Id, new UpdateBrandingRequest(
                string.IsNullOrWhiteSpace(LogoUrl) ? null : LogoUrl, PrimaryColor, SecondaryColor,
                string.IsNullOrWhiteSpace(AccentColor) ? null : AccentColor));
            Message = "Branding updated.";
        }
        catch (Exception ex) { Error = ex.Message; }
        finally { Busy = false; }
    }
}
