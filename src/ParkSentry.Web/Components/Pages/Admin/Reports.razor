@page "/admin/reports"
@attribute [Authorize(Roles = "SUPER_ADMIN,ORGANIZATION_ADMIN,SITE_MANAGER")]
@inject ReportingService ReportingService
@inject SiteService SiteService
@rendermode InteractiveServer

<PageTitle>Reports - ParkSentry</PageTitle>

<h1>Operational Report</h1>
<p class="muted">Tenant-isolated aggregates. Times are UTC.</p>

@if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-danger">@Error</div> }

<div class="card">
    <div class="form-grid">
        <label>From (UTC date) <input class="form-control" type="date" @bind="FromDate" /></label>
        <label>To (UTC date) <input class="form-control" type="date" @bind="ToDate" /></label>
        <label>Site
            <select class="form-control" @bind="SiteIdValue">
                <option value="">All sites</option>
                @foreach (var s in Sites)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </label>
        <button class="btn btn-primary" @onclick="LoadAsync">Run report</button>
    </div>
</div>

@if (Report is not null)
{
    <div class="stats-grid">
        <div class="stat"><span>Active sessions</span><strong>@Report.ActiveSessions</strong></div>
        <div class="stat"><span>Entries</span><strong>@Report.DailyEntries</strong></div>
        <div class="stat"><span>Exits</span><strong>@Report.DailyExits</strong></div>
        <div class="stat"><span>Revenue</span><strong>@Report.Revenue.ToString("0.00")</strong></div>
        <div class="stat"><span>Outstanding</span><strong>@Report.OutstandingPayments.ToString("0.00")</strong></div>
        <div class="stat"><span>Safety fees</span><strong>@Report.SafetyFees.ToString("0.00")</strong></div>
        <div class="stat"><span>Security events</span><strong>@Report.SecurityEvents</strong></div>
        <div class="stat"><span>Watchlist hits</span><strong>@Report.WatchlistHits</strong></div>
        <div class="stat"><span>Bay utilization</span><strong>@Report.BayUtilizationPercent%</strong></div>
    </div>

    <div class="card">
        <h2>Payment methods</h2>
        @if (Report.PaymentMethodTotals.Count == 0)
        {
            <p class="muted">No payments in range.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Method</th><th>Count</th><th>Amount</th></tr></thead>
                <tbody>
                @foreach (var m in Report.PaymentMethodTotals)
                {
                    <tr><td>@m.Method</td><td>@m.Count</td><td>@m.Amount.ToString("0.00")</td></tr>
                }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private OperationalReportDto? Report;
    private List<SiteDto> Sites = [];
    private DateTime FromDate = DateTime.UtcNow.Date;
    private DateTime ToDate = DateTime.UtcNow.Date.AddDays(1);
    private string SiteIdValue = "";
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        Sites = (await SiteService.GetSitesAsync()).ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Error = null;
        try
        {
            Guid? siteId = Guid.TryParse(SiteIdValue, out var id) ? id : null;
            Report = await ReportingService.GetOperationalReportAsync(FromDate.ToUniversalTime().Date, ToDate.ToUniversalTime().Date.AddDays(1), siteId);
        }
        catch (Exception ex) { Error = ex.Message; }
    }
}
